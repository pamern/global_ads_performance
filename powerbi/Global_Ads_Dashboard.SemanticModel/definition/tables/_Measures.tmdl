	measure 'Revenue Growth Label' = VAR g = [Revenue Growth %] RETURN IF(ISBLANK(g), "No prior-period data", FORMAT(g, "+0.0%;-0.0%;0.0%") & " vs. previous period")
		displayFolder: Funnel
