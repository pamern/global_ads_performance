		lineageTag: 680418c7-df4e-4f12-b8d7-69d57629d594

	measure 'DSS Comparison Insight' =
			VAR Advantage = [DSS Paired Advantage pp]
			VAR Periods = [DSS Paired Periods]
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), IF(Periods > 0, SELECTEDVALUE('DSS Strategy'[Strategy]) & ": " & Periods & " paired periods. DSS mean uplift " & IF(Advantage > 0, "higher by ", IF(Advantage < 0, "lower by ", "equal at ")) & FORMAT(ABS(Advantage), "0.00") & " pp. " & [DSS Strategy Feasibility] & ".", "No paired results available for this benchmark."))
		displayFolder: DSS
		lineageTag: d458bfe0-4e66-4dd8-8361-d08e339e0a77

	column Value
		isHidden
		formatString: 0
		lineageTag: ac03d321-49c9-4c59-b137-5bb1d69eded9
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = { BLANK() }

	annotation PBI_Id = 6fc586a7c8924a74826dbfd57b49d532

