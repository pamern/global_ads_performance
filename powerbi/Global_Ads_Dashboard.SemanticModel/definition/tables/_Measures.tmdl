	measure 'DSS Decision Label' = IF(HASONEVALUE('dss runs'[run_id]), SWITCH(SELECTEDVALUE('dss runs'[decision_status]), "baseline_fallback", "Maintain Current Allocation", "descriptive_candidate_incremental_value", "Consider Reallocation", "descriptive_candidate_limited_selector_value", "Reallocation – Limited Evidence", BLANK()))
		displayFolder: DSS
		lineageTag: 49a90315-cee8-4a31-8ace-50ce9a977553

	measure 'DSS Decision Reason' = IF(HASONEVALUE('dss runs'[run_id]), SWITCH(SELECTEDVALUE('dss runs'[decision_status]), "baseline_fallback", "No reallocation met the selection requirements.", "descriptive_candidate_incremental_value", "Outperformed matched-simple in all six validation periods and met DSS improvement criteria.", "descriptive_candidate_limited_selector_value", "A suitable allocation exists; benchmark evidence does not meet all selection criteria.", BLANK()))
		displayFolder: DSS
		lineageTag: c02e6496-c6ac-4507-b314-8467c3825010

	measure 'DSS Recommended Action' =
			VAR Changes =
			    ADDCOLUMNS(VALUES('dss allocations'[platform]), "@Change", [DSS Budget Change])
			VAR Sources =
			    CONCATENATEX(FILTER(Changes, [@Change] < -0.005), 'dss allocations'[platform], ", ", 'dss allocations'[platform], ASC)
			VAR Targets =
			    CONCATENATEX(FILTER(Changes, [@Change] > 0.005), 'dss allocations'[platform] & " (+" & FORMAT([@Change] / 1000, "$0.0") & "K)", " and ", 'dss allocations'[platform], ASC)
			RETURN
			IF(
			    HASONEVALUE('dss runs'[run_id]),
			    IF(
			        SELECTEDVALUE('dss runs'[decision_status]) = "baseline_fallback",
			        "Maintain current allocation; no budget redistribution.",
			        IF(
			            Sources <> "" && Targets <> "",
			            "Shift " & FORMAT([DSS Budget to Move] / 1000, "$0.0") & "K from " & Sources & " to " & Targets & ".",
			            "No budget redistribution indicated."
			        )
			    )
			)
		displayFolder: DSS
		lineageTag: 7daad213-493d-4bb1-be45-e4d038f7b531

	measure 'DSS OOT Mean Uplift' = IF(HASONEVALUE('dss runs'[run_id]), SELECTEDVALUE('dss runs'[oot_mean_uplift]))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: DSS
