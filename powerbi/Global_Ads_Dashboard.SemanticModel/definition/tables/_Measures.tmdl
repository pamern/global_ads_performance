	measure 'Growth Comparison Subtitle' = VAR d = DATEDIFF(MIN('mart DimDate'[Date]), MAX('mart DimDate'[Date]), DAY) + 1 RETURN IF(ISBLANK([Previous Period Spend]), "No prior-period data (data starts 01 Jan 2024)", "vs. previous " & d & " days")
		displayFolder: Growth
