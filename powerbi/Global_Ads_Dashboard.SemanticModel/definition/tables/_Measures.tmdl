	measure 'DSS Strategy Mean Uplift' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), CALCULATE(AVERAGE('dss validation'[revenue_uplift]), TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift])))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: DSS
		lineageTag: 964428aa-27de-46bf-9eb8-997804642c0e

	measure 'DSS Strategy Worst Uplift' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), CALCULATE(MIN('dss validation'[revenue_uplift]), TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift])))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: DSS
		lineageTag: 334aeac1-5802-4181-985a-5670e9aed13a

	measure 'DSS Strategy Average Movement' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), CALCULATE(AVERAGE('dss validation'[moved_share]), TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift])))
		formatString: 0.0%
		displayFolder: DSS
		lineageTag: 9b25531b-0ded-4182-81a8-53726921c786

	measure 'DSS Strategy Valid Periods' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), CALCULATE(COUNTROWS('dss validation'), TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift])))
		formatString: 0
		displayFolder: DSS
		lineageTag: 4a3378d6-5d0d-4ac5-aa6c-b7432137d7a3

	measure 'DSS Strategy Positive Months' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			VAR N = [DSS Strategy Valid Periods]
			VAR Positive = CALCULATE(COUNTROWS('dss validation'), TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift]), 'dss validation'[revenue_uplift] > 0)
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), IF(N > 0, COALESCE(Positive, 0) & " / " & N, "N/A"))
		displayFolder: DSS
		lineageTag: 3c9e0596-72e1-4592-b5fb-1fc14f145838

	measure 'DSS Strategy Feasibility' =
			VAR Code = SELECTEDVALUE('DSS Strategy'[Code])
			VAR Results = CALCULATETABLE('dss validation', TREATAS({Code}, 'dss validation'[strategy]), 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift]))
			VAR SupportKnown = COUNTROWS(FILTER(Results, NOT ISBLANK('dss validation'[inside_support])))
			VAR FunnelKnown = COUNTROWS(FILTER(Results, NOT ISBLANK('dss validation'[pass_funnel])))
			VAR SupportPass = COUNTROWS(FILTER(Results, 'dss validation'[inside_support] == TRUE()))
			VAR FunnelPass = COUNTROWS(FILTER(Results, 'dss validation'[pass_funnel] == TRUE()))
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), IF(COUNTROWS(Results) > 0, "Support " & IF(SupportKnown > 0, COALESCE(SupportPass, 0) & "/" & SupportKnown, "N/A") & " · Funnel " & IF(FunnelKnown > 0, COALESCE(FunnelPass, 0) & "/" & FunnelKnown, "N/A"), "N/A"))
		displayFolder: DSS
		lineageTag: a8d88987-5626-46b0-8d72-1bbdad7d452e

	measure 'DSS Paired Advantage pp' =
			VAR Pairs = FILTER(ADDCOLUMNS(VALUES('dss validation'[test_month]), "@DSS", CALCULATE([DSS OOT Monthly Uplift], 'dss validation'[found] = TRUE()), "@Benchmark", [DSS Strategy Mean Uplift]), NOT ISBLANK([@DSS]) && NOT ISBLANK([@Benchmark]))
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), AVERAGEX(Pairs, [@DSS] - [@Benchmark]) * 100)
		formatString: +0.00" pp";-0.00" pp";0.00" pp"
		displayFolder: DSS
		lineageTag: 20532bca-84f0-45a5-98e1-9a09b5c189d9

	measure 'DSS Paired Periods' =
			VAR Pairs = FILTER(ADDCOLUMNS(VALUES('dss validation'[test_month]), "@DSS", CALCULATE([DSS OOT Monthly Uplift], 'dss validation'[found] = TRUE()), "@Benchmark", [DSS Strategy Mean Uplift]), NOT ISBLANK([@DSS]) && NOT ISBLANK([@Benchmark]))
			RETURN IF(HASONEVALUE('dss runs'[run_id]) && HASONEVALUE('DSS Strategy'[Code]), COUNTROWS(Pairs))
		formatString: 0
		displayFolder: DSS
		lineageTag: 6f8b49d6-5dbb-4fe2-905e-4f2a47c5e314

	measure 'DSS OOT Budget Movement' = IF(HASONEVALUE('dss runs'[run_id]), CALCULATE(AVERAGE('dss validation'[moved_share]), 'dss validation'[strategy] = "dss", 'dss validation'[found] = TRUE(), NOT ISBLANK('dss validation'[revenue_uplift])))
		formatString: 0.0%
