table 'mart FctAdPerformance'
	lineageTag: 65fbb1e9-cb49-4953-8494-df5bd8cffbf1

	measure 'Total Ad Spend' =
			
			SUM('mart FctAdPerformance'[AdSpend])
		lineageTag: 91aab636-9e4d-4109-a312-75836a907e77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Clicks' =
			
