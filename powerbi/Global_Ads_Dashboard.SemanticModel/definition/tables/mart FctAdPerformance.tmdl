	measure 'Total Revenue' =
			
			SUM('mart FctAdPerformance'[Revenue])
		lineageTag: d8aaca24-206c-467d-86be-46fbba9b78b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ROAS =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Ad Spend]
