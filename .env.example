# Existing Supabase PostgreSQL URL; dev wrapper reuses this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Local is independent of DATABASE_URL.
LOCAL_PGHOST=127.0.0.1
LOCAL_PGPORT=55432
LOCAL_PGUSER=nexora
LOCAL_PGPASSWORD=
LOCAL_PGDATABASE=nexora
# Dev builds remain blocked until verified; see dbt-modeling/README.md.
# NEXORA_DEV_VERIFIED=HOST/postgres
